extends layout

block Subject
	title 레전드끄투 - 단어장

block CSS
	link(rel='stylesheet', href='/css/in_game_kkutu.css')

block Middle
	+separator(5)
	div.WordBox.Product
		h5.product-title
			+FA('book')
			label 단어장
			label#wordCount
		div.product-body
			div#wordControl
				select#themeSelect
					option(value='') 주제를 선택하세요
				button#searchBtn(type='button') 검색
				button#downloadBtn(type='button', style='display: none;') TXT 파일로 다운로드
			div#loadingSpinner.hidden
				+FA('spinner fa-spin')
				|  불러오는 중...
			div#wordList
	+separator(10)

block Bottom
	div.bottom-legal!= L('Copyright')
	div.bottom-legal!= L('Dictionary')
	div.bottom-legal!= L('License')
