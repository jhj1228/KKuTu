extends layout

block Subject
	title= L('title')

block CSS
	link(rel='stylesheet', href='/css/in_game_kkutu.css')
	link(rel='stylesheet', href='/css/theme/base.css')
	link(rel='stylesheet', href='/css/theme/topbar.css')
	link(rel='stylesheet', href='/css/theme/components.css')
	link(rel='stylesheet', href='/css/theme/portal.css')

block JS
	script.
		$(function() {
			$('#gn-content').html(function(i, h) { return h.replace(/<br\s*\/?>/gi, ' · '); });
			$('#global-notice').appendTo('.portal-notice');
		});

block Middle
	-
		var SHORTCUTS = [
			{ icon: 'book', label: '도움말', href: '/help' },
			{ icon: 'youtube-play', label: '유튜브', href: 'https://www.youtube.com/@%EC%A0%95%ED%9D%AC%EC%A0%95-p6o' },
			{ icon: 'comments', label: '디스코드' },
			{ icon: 'github', label: '깃허브', href: 'https://github.com/jhj1228/KKuTu' }
		];
	div.portal-notice
	div.portal
		div.portal-hero
			img.portal-logo(src='/img/kkutu/short_logo.png', alt='KKuTu')
			h1#holder= L('title').replace(/\[.+?\]/g, "")
			p.portal-desc= locals.ogDescription || '레전드끄투에서 나만의 단어 실력을 뽐내보세요!'
			button#game-start= L('gameStart')
		div.server-list-box
			div.server-list-title
				label= L('serverList')
				label#server-total
				a#server-refresh
					+FA('refresh')
					+Expl(L('serverRefresh'))
			div#server-list
			div.portal-shortcuts
				div.portal-section-title 바로가기
				div.shortcut-grid
					- for (var s = 0; s < 8; s++)
						- var sc = SHORTCUTS[s];
						if sc
							a.shortcut(href=sc.href, target='_blank', rel='noopener', title=sc.label)
								+FA(sc.icon)
								div.shortcut-label= sc.label
						else
							div.shortcut.shortcut-empty
		div.portal-board.portal-updates
			div.portal-board-title 업데이트 로그
			iframe.portal-board-frame(src='/kkutu_bulletin.html#updates')
		div.portal-side
			div.portal-board.portal-notices
				div.portal-board-title 공지사항
				iframe.portal-board-frame(src='/kkutu_bulletin.html#notices')
			div#portal-ad.portal-ad 여기에뭘넣어야할지모르겟슨

block Bottom
	div.bottom-legal!= L('Copyright')
	div.bottom-legal!= L('Dictionary')
	div.bottom-legal!= L('License')